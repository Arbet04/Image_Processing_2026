# คัดลอกเป็น .env แล้วแก้ค่าให้ตรงกับเครื่องจริง
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_EXPIRES_HOURS=24

# ตอนนี้ใช้ SQLite ไปก่อน (สร้างไฟล์ instance/app.db และตารางให้อัตโนมัติ)
# ภายหลังเปลี่ยนเป็น PostgreSQL: postgresql://<user>:<password>@<host>:5432/<dbname>
DATABASE_URL=sqlite:///app.db

# IP เครื่อง AI Engineer (Tailscale IP ถ้าใช้ VPN) — AI Service รันที่ port 8001
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT=600

# 1 = เปิด debugger (ใช้เฉพาะตอนรันบนเครื่องตัวเอง ห้ามเปิดตอนให้คนอื่นเข้าถึง)
FLASK_DEBUG=0
